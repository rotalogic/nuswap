# Salin file ini menjadi .env untuk jalan lokal (dibaca Docker Compose, Next.js,
# dan `npm run db:migrate`), atau isi di dashboard hosting (Vercel) untuk produksi.

# Koneksi PostgreSQL.
# Lokal via docker compose: postgres://nuswap:nuswap@localhost:5432/nuswap
# Produksi: pakai connection string PostgreSQL dari Supabase / penyedia Postgres lain.
DATABASE_URL=postgres://nuswap:nuswap@localhost:5432/nuswap

# Akun admin, dibuat saat menjalankan `npm run db:migrate`. Password wajib diisi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Rahasia penanda tangan sesi admin. Wajib, minimal 32 karakter; tanpa ini login
# admin dimatikan. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# URL publik situs (tanpa garis miring di akhir), diisi sebelum build. Dipakai
# untuk alamat gambar thumbnail Open Graph agar terbaca LinkedIn, WhatsApp, dll.
# Contoh produksi: https://nuswap.rotalogic.id
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Jumlah proxy di depan aplikasi (Nginx, Cloudflare, dst.), untuk mengenali IP
# pengunjung pada rate limit. Di Vercel tidak perlu diisi.
TRUSTED_PROXY_HOPS=1
