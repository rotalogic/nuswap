# Salin file ini menjadi .env.local untuk jalan lokal, atau isi di dashboard
# hosting (Vercel) untuk produksi.

# Koneksi PostgreSQL.
# Lokal via docker compose: postgres://nuswap:nuswap@localhost:5432/nuswap
# Produksi: pakai connection string PostgreSQL dari Supabase / penyedia Postgres lain.
DATABASE_URL=postgres://nuswap:nuswap@localhost:5432/nuswap

# Akun admin awal, dibuat saat menjalankan `npm run db:migrate`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Rahasia penanda tangan cookie sesi admin (acak, panjang). Boleh dikosongkan
# untuk lokal; untuk produksi sebaiknya diisi.
SESSION_SECRET=

# URL publik situs (tanpa garis miring di akhir). Dipakai untuk alamat
# gambar thumbnail Open Graph agar terbaca LinkedIn, Threads, WhatsApp, dll.
# Contoh produksi: https://nuswap.rotalogic.id
NEXT_PUBLIC_SITE_URL=http://localhost:3100
